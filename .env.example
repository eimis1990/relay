# Exact origin, no path. Example https://relay-example.vercel.app
APP_URL=http://localhost:3000
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Generate locally: openssl rand -base64 48
AUTH_SECRET=
# Comma-separated Microsoft email addresses permitted to connect. Required.
RELAY_ALLOWED_MICROSOFT_ACCOUNTS=

# Server-only persistent workspace database. Never use NEXT_PUBLIC_ for keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# AI inbox review: server-only. OpenAI API billing is separate from ChatGPT.
OPENAI_API_KEY=
# Optional; default supports Responses structured outputs and reasoning effort none.
OPENAI_REVIEW_MODEL=gpt-5.4-mini
